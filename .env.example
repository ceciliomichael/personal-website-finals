# Copy to .env and change the password before starting Docker.
POSTGRES_USER=orbital
POSTGRES_DB=orbital_portfolio
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_PORT=5432
# Keep this volume name stable across deployments and redeployments.
# If PostgreSQL already has data in a different volume, use that existing name
# or migrate its contents before switching. Do not switch between names later.
POSTGRES_VOLUME_NAME=portfolio-port_orbital_postgres_data

# Public app port and bind address. Point your domain/reverse proxy here.
APP_PORT=3000
APP_BIND_ADDRESS=0.0.0.0
